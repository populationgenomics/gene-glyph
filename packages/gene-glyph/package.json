{
  "name": "@populationgenomics/gene-glyph",
  "version": "1.0.0",
  "description": "Gene-level annotation viewer with multi-coordinate alignment, pluggable tracks, and camera-ready vector export.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly && cp src/styles.css dist/styles.css",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": ">=18.0.0 <20.0.0",
    "react-dom": ">=18.0.0 <20.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.12",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "jsdom": "^28.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vitest": "^4.0.18"
  },
  "keywords": [
    "gene",
    "variant",
    "visualization",
    "bioinformatics",
    "react",
    "svg"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/populationgenomics/gene-glyph.git"
  },
  "bugs": {
    "url": "https://github.com/populationgenomics/gene-glyph/issues"
  },
  "homepage": "https://github.com/populationgenomics/gene-glyph#readme",
  "author": "Centre for Population Genomics"
}
